{
  "name": "releaseasy",
  "version": "0.0.0",
  "description": "Release made easy",
  "keywords": [
    "bump",
    "changelog",
    "changelog-generator",
    "ci-cd",
    "developer-tool",
    "git",
    "git-release",
    "git-tag",
    "npm-publishing",
    "npm-release",
    "release",
    "release-automation",
    "release-cli",
    "semver",
    "version-bump"
  ],
  "bugs": {
    "url": "https://github.com/releaseasy/releaseasy/issues"
  },
  "license": "MIT",
  "author": "ajiho",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/releaseasy/releaseasy.git"
  },
  "funding": "https://www.lujiahao.com/sponsor",
  "bin": {
    "releaseasy": "./dist/cli.js"
  },
  "files": [
    "dist/",
    "scheme/"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "prepare": "simple-git-hooks",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "lint:fix": "pnpm run lint --fix",
    "size": "size-limit",
    "clean": "rimraf dist",
    "rolldown": "rolldown -c",
    "rolldown:watch": "rolldown -c -w",
    "build": "run-s clean rolldown size",
    "test": "vitest --coverage",
    "test:ui": "pnpm run test --ui",
    "coverage": "vitest run --coverage",
    "publint": "publint",
    "check": "run-s lint coverage build publint",
    "release": "node src/cli.js"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.2",
    "ansis": "^4.3.1",
    "commander": "^15.0.0",
    "consola": "^3.4.2",
    "lilconfig": "^3.1.3",
    "package-manager-detector": "^1.8.0",
    "picospinner": "^3.1.2",
    "semver": "^7.8.5",
    "tinyexec": "^1.3.1",
    "defu": "^6.1.7"
  },
  "devDependencies": {
    "@size-limit/file": "^13.0.3",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "cross-env": "^10.1.0",
    "fs-extra": "^11.4.0",
    "jiti": "^2.7.0",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.62.0",
    "oxlint": "^1.82.0",
    "pkg-types": "^2.3.3",
    "publint": "^0.3.24",
    "rimraf": "^6.1.3",
    "rolldown": "^1.2.8",
    "rolldown-plugin-copy-files": "^0.2.0",
    "simple-git-hooks": "^2.14.0",
    "size-limit": "^13.0.3",
    "valibot": "^1.5.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "jiti": "*"
  },
  "peerDependenciesMeta": {
    "jiti": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "git-cliff-darwin-arm64": "2.13.1",
    "git-cliff-darwin-x64": "2.13.1",
    "git-cliff-linux-arm64": "2.13.1",
    "git-cliff-linux-x64": "2.13.1",
    "git-cliff-windows-arm64": "2.13.1",
    "git-cliff-windows-x64": "2.13.1"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm check"
  },
  "engines": {
    "bun": ">=1",
    "git": ">=2.11.0",
    "node": ">=22",
    "npm": ">=10",
    "pnpm": ">=11",
    "yarn": ">=1.7.0"
  },
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457"
}
