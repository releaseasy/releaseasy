{
  "$schema": "./schema/releaseasy.json",
  "increments": ["patch", "minor", "major"],
  "distTags": ["latest", "next"],
  "git": {
    "changelog": {
      "output": "CHANGELOG.md",
      "configFile": "cliff.toml",
      "args": "--tag ${version}"
    }
  },
  "hooks": {
    "after:changelog": "oxfmt --write CHANGELOG.md",
    "after:bump": "oxfmt --write package.json"
  }
}
